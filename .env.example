# ---- ROLLCALL mobile app environment ----
# Copy this file to `.env` and fill in the blanks.
# Only EXPO_PUBLIC_* vars are exposed to the app bundle.

# Base URL of the backend API. Use your machine's LAN IP (NOT localhost) so a
# physical phone running Expo Go can reach it, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000

# ---- Clerk (authentication) ----
# Clerk publishable key from the Clerk dashboard → API Keys. This is safe to ship
# in the client bundle (it's not a secret). Must be the SAME Clerk instance whose
# CLERK_SECRET_KEY the backend uses, or token verification will fail.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
