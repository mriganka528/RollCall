# ---- ROLLCALL mobile app environment ----
# Copy this file to `.env` and fill in the blanks.
# Only EXPO_PUBLIC_* vars are exposed to the app bundle.

# The DEPLOYED backend on Vercel. Used as the default when no explicit
# EXPO_PUBLIC_API_URL is set and there's no local Metro host to auto-detect.
EXPO_PUBLIC_DEPLOYED_API_URL=https://roll-call-self.vercel.app

# Base URL of the backend API. Point this at the deployed backend so API calls
# work from any device, any time. For LOCAL backend development, comment this
# line out to auto-detect the Metro host, or set your machine's LAN IP (e.g.
# http://192.168.1.20:4000) — never `localhost` for a physical phone.
EXPO_PUBLIC_API_URL=https://roll-call-self.vercel.app

# ---- Clerk (authentication) ----
# Clerk publishable key from the Clerk dashboard → API Keys. This is safe to ship
# in the client bundle (it's not a secret). Must be the SAME Clerk instance whose
# CLERK_SECRET_KEY the backend uses, or token verification will fail.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Native Google Sign-In ----
# Enables the NATIVE Google account picker (Android Credential Manager / iOS)
# instead of the web-browser OAuth flow. These are OAuth *client IDs* from Google
# Cloud Console → APIs & Services → Credentials — public identifiers, not secrets,
# so they're safe to ship. See SETUP.md for the full walkthrough.
#
# Required on Android (this is the "Web application" OAuth client ID — yes, the
# WEB one, even for Android; Clerk uses it as the token audience):
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
#
# iOS only (leave blank for an Android-only build): the "iOS" OAuth client ID,
# plus its reversed form as a URL scheme so Google can return to the app.
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-yyyyyyyyyyyy.apps.googleusercontent.com
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxxxxxx-yyyyyyyyyyyy
