{
  "expo": {
    "name": "ROLLCALL",
    "slug": "qr-attendence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rollcall-icon-v2.png",
    "scheme": "rollcall",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/images/rollcall-adaptive-foreground-v2.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mriganka528.qrattendence"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rollcall-icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA",
          "dark": {
            "backgroundColor": "#FAFAFA"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QR Attendance to use the camera to scan attendance QR codes."
        }
      ],
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9570e34-0ce2-4c52-acc8-08cca59e33af"
      }
    }
  }
}
