# ---- ROLLCALL backend environment ----
# Copy this file to `.env` and fill in the blanks. `.env` is gitignored.
# Do NOT put real secrets in this example file — placeholders only.

# Neon Postgres connection string used at runtime (Prisma reads this).
# Use the POOLED endpoint — its host contains `-pooler`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint-pooler.your-region.aws.neon.tech/neondb?sslmode=require

# DIRECT (non-pooled) connection, used ONLY by `prisma migrate` / `db push`.
# Same as DATABASE_URL but with `-pooler` removed from the host. Migrations fail
# through the pooler, so this must be set before running migrations.
DIRECT_URL=postgresql://USER:PASSWORD@ep-your-endpoint.your-region.aws.neon.tech/neondb?sslmode=require

# ---- Clerk (authentication) ----
# Clerk is the identity provider. Get these from the Clerk dashboard → API Keys.
# The SECRET key is required: the backend verifies mobile Bearer tokens with it.
# Keep it secret — never expose it to the app bundle or commit it.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# The publishable key is optional for this backend (it's only used by Clerk's
# redirect handshake for web apps). Provide it if you like; the same value also
# goes in the mobile app's .env as EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Port the API listens on.
PORT=4000
